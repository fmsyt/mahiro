{
  "build": {
    "beforeDevCommand": "pnpm tauri:dev:ui",
    "beforeBuildCommand": "pnpm tauri:build:ui",
    "frontendDist": "../tauri.dist",
    "devUrl": "http://localhost:1421"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "static"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "ja-JP"
        ]
      }
    }
  },
  "productName": "mahiro",
  "version": "0.9.3",
  "identifier": "mahiro.yotta-rc.dev",
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "config",
          "short": "c",
          "takesValue": false
        }
      ]
    }
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "mahiro",
        "width": 800,
        "height": 600,
        "url": "tauri.html",
        "visible": true
      },
      {
        "label": "config",
        "fullscreen": false,
        "resizable": true,
        "title": "Config - mahiro",
        "width": 800,
        "height": 600,
        "url": "config.html",
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$APPLOCALDATA/uploads/icons/*"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}